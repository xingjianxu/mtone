    "@blocknote/react": "0.57.0",
    "lucide-react": "1.73.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingjianxu/mtone.git",
    "directory": "packages/mtone-blockeditor"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
