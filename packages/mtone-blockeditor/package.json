    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css"
  },
  "peerDependencies": {
    "@bixlab/mtone": "^0.14.0 || ^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
