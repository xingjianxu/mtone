{
  "name": "@bixlab/mtone",
  "version": "0.9.0",
  "type": "module",
  "description": "Compact, ready-styled React components powered by Base UI",
  "files": [
    "dist",
    "llms.txt"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./llms.txt": "./llms.txt"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-llms.mjs && tsup src/index.ts --format esm --dts --external react --external react-dom --external @base-ui/react --external lucide-react && tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@rc-component/table": "^1.12.0",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "lucide-react": "1.73.0",
    "react-resizable-panels": "4.24.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingjianxu/mtone.git",
    "directory": "packages/mtone"
  },
  "homepage": "https://xingjianxu.github.io/mtone/",
  "bugs": {
    "url": "https://github.com/xingjianxu/mtone/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
