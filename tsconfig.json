{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@bixlab/mtone": ["./packages/mtone/src/index.ts"],
      "@bixlab/mtone-blockeditor": ["./packages/mtone-blockeditor/src/index.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/mtone/src", "packages/mtone-blockeditor/src", "apps/docs", "tests"]
}
